{
  "name": "crivo-indica-site",
  "main": "worker.js",
  "compatibility_date": "2026-07-31",
  "routes": [
    {
      "pattern": "crivoindica.com.br",
      "custom_domain": true
    },
    {
      "pattern": "www.crivoindica.com.br",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
